<?xml version="1.0" encoding="utf-8"?>
<!-- scene_home's top-bar button: plain text at rest, a solid warm-white pill while focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFFAF6EF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <!-- Reorder button while reorder mode is on (focus is on the tiles then). -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#596EC1FF" />
            <stroke android:width="1.5dp" android:color="#FF6EC1FF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</selector>
