<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF2C3440" />
            <corners android:radius="16dp" />
            <stroke android:width="3dp" android:color="#FFB9E7C7" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF242B34" />
            <corners android:radius="16dp" />
            <stroke android:width="3dp" android:color="#FF4DAE6D" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF1A2027" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
