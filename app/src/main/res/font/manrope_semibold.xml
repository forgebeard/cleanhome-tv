<?xml version="1.0" encoding="utf-8"?>
<!-- Manrope at weight 600: fills the launcher's "medium" slot (labels, buttons); Manrope reads lighter than
     Outfit at a distance on a TV. Built once per process (same approach as outfit_*.xml). -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <font
        android:font="@font/manrope"
        android:fontStyle="normal"
        android:fontWeight="600"
        android:fontVariationSettings="'wght' 600"
        tools:targetApi="28" />
</font-family>
